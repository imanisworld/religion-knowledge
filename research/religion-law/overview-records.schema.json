{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Religion & Law Overview Records",
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "label",
        "url",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 3
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "type": {
          "enum": [
            "legal",
            "polling",
            "advocacy",
            "status_tracker",
            "comparative",
            "comparative_primary",
            "research"
          ]
        }
      }
    },
    "policyRecord": {
      "type": "object",
      "required": [
        "id",
        "issue",
        "government_question",
        "religion_involvement",
        "legal_status",
        "sources",
        "last_verified",
        "confidence",
        "scope_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^POL-[A-Z0-9-]+$"
        },
        "issue": {
          "type": "string",
          "minLength": 3
        },
        "government_question": {
          "type": "string",
          "minLength": 10
        },
        "religion_involvement": {
          "type": "string",
          "minLength": 10
        },
        "legal_status": {
          "type": "string",
          "minLength": 10
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "last_verified": {
          "type": "string",
          "format": "date"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "contested"
          ]
        },
        "scope_note": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "globalRecord": {
      "type": "object",
      "required": [
        "id",
        "issue",
        "us_structure",
        "global_structure",
        "sources",
        "last_verified",
        "confidence",
        "scope_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^GLOBAL-[A-Z0-9-]+$"
        },
        "issue": {
          "type": "string",
          "minLength": 3
        },
        "us_structure": {
          "type": "string",
          "minLength": 10
        },
        "global_structure": {
          "type": "string",
          "minLength": 10
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "last_verified": {
          "type": "string",
          "format": "date"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "contested"
          ]
        },
        "scope_note": {
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}
